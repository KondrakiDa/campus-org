# ==========================================================
#  把下面的值换成你自己的，然后把这个文件另存为 .env.local
#  注意：文件名就是 .env.local，前面有个点，没有 .example
# ==========================================================

# 去哪找这两个值：
#   Supabase 控制台 → 你的项目 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://你的项目ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=你的anon_public_key

# ----------------------------------------------------------
#  ⚠️  绝对不要把这个 key 写进这里：
#      service_role key（它绕过所有权限，一旦泄露整个数据库被人随便改）
#      只在前端用 anon key，权限由数据库的 RLS 兜底
# ----------------------------------------------------------
